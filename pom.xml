<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    代码生成器。

    刻意【不依赖】任何 framework-* 模块：它只产出源码文本，运行时不需要框架类。
    这样生成器可以独立于框架版本演进，也避免让业务方为了跑生成器而拖进整个框架依赖树。
    唯一的关联是产出的代码引用框架基类 —— 那是文本层面的耦合，由模板保证。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>codegen</artifactId>
  <!-- 版本号与 framework 保持一致（见 develop_plan.md §9.4）：生成的薄代码继承框架基类，
       兼容性成对理解；「按框架版本取对应 codegen」也因此可查表确定。 -->
  <version>0.2.0</version>

  <name>describeadmin :: codegen</name>
  <description>以 YAML/DSL 为输入的代码生成器</description>
  <url>https://github.com/describeadmin/codegen</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/codegen.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/codegen.git</developerConnection>
    <url>https://github.com/describeadmin/codegen</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      构建 JDK 只要求 17 或更高（enforcer 的 requireJavaVersion 兜底），用哪个由构建者自己定。
      不用 maven-toolchains-plugin 钉死具体版本：release=17 已保证产物在 Java 17 上可运行，
      钉一个具体版本只会让没配 ~/.m2/toolchains.xml 的人构建失败（VERSION_BASELINE 第八轮）。
    -->
    <maven.compiler.release>17</maven.compiler.release>

    <snakeyaml.version>2.4</snakeyaml.version>
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.6</assertj.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <!-- 唯一的构建前提：JDK >= 17。release=17 约束的是产物，与构建 JDK 无关。 -->
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <!-- 打成可直接执行的 fat jar，便于业务方与 AI Agent 一条命令调用 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>codegen</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.describeadmin.codegen.CodegenCli</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
